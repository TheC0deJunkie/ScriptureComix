# Copy to .env (never commit .env)

# Google Gemini — used for comic scripts, panel images, explanations,
# and reconstructing verses that are missing from the bundled dataset.
VITE_GEMINI_API_KEY=

# Optional: OpenAI-compatible Groq endpoint for text tasks (explain, quiz,
# verse reconstruction fallback when no Gemini key is present).
VITE_GROQ_API_URL=
VITE_GROQ_API_KEY=

# Runtime AI for verses / quizzes / context. Default: on in `vite` dev (so
# what you open gets generated and written into public/data), OFF in
# production builds — readers only get what was pre-generated. Set to true
# to allow generation in a production build.
VITE_RUNTIME_AI=

# Firebase (project: scripturecomix). Values come from
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID>
# These are public client identifiers; access is enforced by Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=scripturecomix.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scripturecomix
VITE_FIREBASE_STORAGE_BUCKET=scripturecomix.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to true to point Auth and Firestore at the local emulators
# (npx -y firebase-tools@latest emulators:start)
VITE_FIREBASE_USE_EMULATORS=

# Origin that serves the translations kept out of git (NLT, NIV, NKJV, NASB,
# NABRE). They are published there with `npm run publish:texts`. The app tries
# its own /data first and only falls back here. Defaults to
# https://scripturecomix.web.app; set to an empty string to disable.
VITE_TEXT_HOST_BASE=

# --- Payments (server-only; set these in Vercel, never with a VITE_ prefix) ---
# Yoco secret key. sk_test_… keys run in test mode; sk_live_… take real money.
# With this unset, payments are switched off and nothing can be bought.
YOCO_SECRET_KEY=
# Signing secret Yoco returns when the webhook is registered:
#   YOCO_SECRET_KEY=… node scripts/registerYocoWebhook.mjs register https://<host>/api/yoco-webhook --vercel production
YOCO_WEBHOOK_SECRET=
# Firebase service-account JSON (raw or base64) so the functions can verify
# sign-in tokens and write entitlements. Firebase console → Project settings →
# Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
# Optional: where Yoco sends buyers back. Defaults to the request's own host.
APP_URL=
