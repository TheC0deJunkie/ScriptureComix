# Copy to .env (never commit .env)

# Google Gemini — used for comic scripts, panel images, explanations,
# and reconstructing verses that are missing from the bundled dataset.
VITE_GEMINI_API_KEY=

# Optional: OpenAI-compatible Groq endpoint for text tasks (explain, quiz,
# verse reconstruction fallback when no Gemini key is present).
VITE_GROQ_API_URL=
VITE_GROQ_API_KEY=

# Runtime AI for verses / quizzes / context. Default: on in `vite` dev (so
# what you open gets generated and written into public/data), OFF in
# production builds — readers only get what was pre-generated. Set to true
# to allow generation in a production build.
VITE_RUNTIME_AI=

# Firebase (project: scripturecomix). Values come from
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID>
# These are public client identifiers; access is enforced by Firestore rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=scripturecomix.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scripturecomix
VITE_FIREBASE_STORAGE_BUCKET=scripturecomix.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to true to point Auth and Firestore at the local emulators
# (npx -y firebase-tools@latest emulators:start)
VITE_FIREBASE_USE_EMULATORS=
